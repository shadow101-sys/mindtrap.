# Optional local configuration. Do not put permanent production secrets here.
PORT=3000
# Comma-separated trusted browser origins when hosting the client separately.
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# Optional TURN configuration for more reliable WebRTC on restricted networks.
TURN_URLS=
TURN_USERNAME=
TURN_CREDENTIAL=

# Optional PostgreSQL persistence (Render Postgres sets this automatically via render.yaml).
DATABASE_URL=
PG_POOL_MAX=10
